# ============================================================
# ARCHITECT PMU PRONO - ELITE PUNTER SYSTEM
# ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================

# Network & Server Port
PORT=3000
NODE_ENV=development

# Database Path (SQLite)
DB_PATH=./data/pmu.db

# Agent AI Remote Control API Key (Optionnel: Sécurise l'API /api/agent)
AGENT_API_KEY=pmu_agent_secret_key_v43

# Telegram Alerts Integration (Optionnel)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Logging & Debug
LOG_LEVEL=info
