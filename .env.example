# ============================================================
# ARCHITECT PMU PRONO - ELITE PUNTER SYSTEM
# ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================

# Network & Server Port
PORT=3000
NODE_ENV=development

# Autorise les frontends hébergés sur d'autres origines (séparées par des virgules).
# Vide par défaut : seules les requêtes sans Origin et l'interface de même origine fonctionnent.
CORS_ORIGINS=

# Database Path (SQLite)
DB_PATH=./data/pmu.db

# Répertoire persistant des poids et métadonnées TensorFlow.js
ML_MODEL_DIR=./data/ml-model

# Agent AI Remote Control API Key (Optionnel: Sécurise l'API /api/agent)
AGENT_API_KEY=

# Telegram Alerts Integration (Optionnel)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Logging & Debug
LOG_LEVEL=info
